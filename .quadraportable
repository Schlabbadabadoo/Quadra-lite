#!/usr/bin/env bash
# Portable Quadra Lite launcher. All user data stays inside this folder.
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
export XDG_DATA_HOME="$DIR/data"
export XDG_CONFIG_HOME="$DIR/config"
export XDG_CACHE_HOME="$DIR/cache"
mkdir -p "$XDG_DATA_HOME" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME"
export PYTHONPATH="$DIR/launcher"
exec python3 -m quadra.cli "$@"
EOF
chmod +x .quadraportable
git add .quadraportable
git commit -m "Add .quadraportable for running from a source checkout"
git push origin main